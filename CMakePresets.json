{
    "version": 6,
    "configurePresets": [
      {
        "name": "debug",
        "displayName": "WSL Debug",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/debug",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "DARWINSIM_BUILD_DISTRIBUTED": "ON",
          "DARWINSIM_BUILD_TESTS": "ON"
        }
      },
      {
        "name": "release",
        "displayName": "WSL Release",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/release",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "DARWINSIM_BUILD_DISTRIBUTED": "ON",
          "DARWINSIM_BUILD_TESTS": "ON"
        }
      },
      {
        "name": "core-only",
        "displayName": "Core only (no gRPC/SQLite/Boost)",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/core-only",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "DARWINSIM_BUILD_DISTRIBUTED": "OFF",
          "DARWINSIM_BUILD_TESTS": "ON"
        }
      }
    ],
    "buildPresets": [
      { "name": "debug", "configurePreset": "debug" },
      { "name": "release", "configurePreset": "release" },
      { "name": "core-only", "configurePreset": "core-only" }
    ],
    "testPresets": [
      { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
      { "name": "core-only", "configurePreset": "core-only", "output": { "outputOnFailure": true } }
    ]
}
