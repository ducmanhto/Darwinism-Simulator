#!/usr/bin/env bash
set -euo pipefail
BASE_URL=${DARWINSIM_URL:-http://localhost:8088}
CMD=${1:-status}

case "$CMD" in
  status) curl -fsS "$BASE_URL/api/state" | jq . ;;
  species) curl -fsS "$BASE_URL/api/species" | jq . ;;
  animals) curl -fsS "$BASE_URL/api/animals?limit=500" | jq . ;;
  terrain) curl -fsS "$BASE_URL/api/terrain" | jq . ;;
   pause) curl -fsS -X POST "$BASE_URL/api/control/pause" | jq . ;;
   resume) curl -fsS -X POST "$BASE_URL/api/control/resume" | jq . ;;
   checkpoint) curl -fsS -X POST "$BASE_URL/api/control/checkpoint" | jq . ;;
   *)
     echo "Usage: DARWINSIM_URL=http://host scripts/evoctl {status|species|animals|terrain|pause|resume|checkpoint}" >&2
     exit 2
     ;;
 esac
